{
  "manifest_version": 3,
  "name": "AFK DM Automation",
  "version": "5.0.0",
  "description": "Creates timed Instagram message drafts every 50 seconds. Review and send manually.",
  "permissions": ["storage", "alarms", "tabs", "sidePanel"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open AFK DM Automation",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
