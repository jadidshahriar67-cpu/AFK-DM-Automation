{
  "manifest_version": 3,
  "name": "Birthday DM Studio V4",
  "version": "4.0.0",
  "description": "Creates timed Instagram message drafts from your custom text. You review and send them manually.",
  "permissions": ["storage", "alarms", "tabs", "sidePanel"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open Birthday DM Studio"},
  "side_panel": {"default_path": "panel.html"},
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}